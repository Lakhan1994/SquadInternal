@model SquadInternal.Models.Asset

@{
    var employees = ViewBag.Employees as IEnumerable<SquadInternal.Models.Employee> ?? Enumerable.Empty<SquadInternal.Models.Employee>();
}

<div class="modal fade" id="assignAssetModal-@Model.Id" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-md modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Assign Asset - @Model.AssetName</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form asp-controller="Admin" asp-action="AssignAsset" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="assetId" value="@Model.Id" />

                    <div class="mb-3">
                        <label class="form-label">Assign To</label>
                        <select name="employeeId" class="form-select" required>
                            <option value="">Select employee</option>
                            @foreach (var e in employees)
                            {
                                <option value="@e.Id">@e.FirstName @e.LastName (@e.UserId)</option>
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Handover Remarks</label>
                        <textarea name="handoverRemarks" class="form-control" rows="3"></textarea>
                    </div>

                    <div class="d-flex justify-content-end">
                        <button type="button" class="btn btn-outline-secondary me-2" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary">Assign</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>