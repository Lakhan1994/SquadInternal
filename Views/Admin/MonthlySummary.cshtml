@model List<SquadInternal.Models.ViewModels.MonthlySummaryRowVM>

@{
    ViewData["Title"] = "Monthly Summary Report";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";

    int selectedMonth = ViewBag.SelectedMonth;
    int selectedYear = ViewBag.SelectedYear;
    var monthName = new DateTime(selectedYear, selectedMonth, 1).ToString("MMMM yyyy");
}

<div class="page-accent d-flex justify-content-between align-items-center">
    <h3 class="m-0">Monthly Summary Report</h3>
    <a class="btn btn-outline-secondary" asp-action="LeaveManagement">
        <i class="bi bi-arrow-left"></i> Back to Leave Management
    </a>
</div>

<div class="card shadow-sm border-0 p-3 mt-3">
    <form method="get" class="row align-items-end g-2">
        <div class="col-md-3">
            <label for="summaryMonth" class="form-label">Month</label>
            <select id="summaryMonth" name="month" class="form-select">
                @for (int m = 1; m <= 12; m++)
                {
                    <option value="@m" selected="@(m == selectedMonth)">
                        @(new DateTime(selectedYear, m, 1).ToString("MMMM"))
                    </option>
                }
            </select>
        </div>
        <div class="col-md-3">
            <label for="summaryYear" class="form-label">Year</label>
            <select id="summaryYear" name="year" class="form-select">
                @for (int y = DateTime.Now.Year - 3; y <= DateTime.Now.Year + 1; y++)
                {
                    <option value="@y" selected="@(y == selectedYear)">@y</option>
                }
            </select>
        </div>
        <div class="col-md-2">
            <button class="btn btn-primary w-100">Filter</button>
        </div>
        <div class="col-md-4 text-md-end">
            <a class="btn btn-outline-success w-100"
               href="@Url.Action("DownloadMonthlySummary", new { month = selectedMonth, year = selectedYear })">
                <i class="bi bi-download"></i> Download Report
            </a>
        </div>
    </form>
</div>

<div class="card shadow-sm border-0 p-3 mt-3">
    <h6>Summary for @monthName</h6>
    <div class="table-responsive">
        <table class="table table-bordered table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>Employee</th>
                    <th>Total Days In Month</th>
                    <th>Total Leaves Taken</th>
                    <th>Total Paid Days</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var row in Model)
                    {
                        <tr>
                            <td>@row.EmployeeName</td>
                            <td>@row.TotalDaysInMonth</td>
                            <td>@row.TotalLeavesTaken</td>
                            <td>@row.TotalPaidDays</td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="4" class="empty-state">No data available.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
