         document.addEventListener('DOMContentLoaded', function () {

            const historyButtons =
                document.querySelectorAll('.history-asset-btn');

            const historyModalElement =
                document.getElementById('assetHistoryModal');

            const historyModal =
                bootstrap.Modal.getOrCreateInstance(historyModalElement);


            historyButtons.forEach(function (button) {

                button.addEventListener('click', async function (e) {

                    e.preventDefault();

                    const assetId =
                        button.dataset.assetId;

                    const assetName =
                        button.dataset.assetName || '';

                    const assetCode =
                        button.dataset.assetCode || '';


                    // Set header
                    document.getElementById('historyAssetName').textContent =
                        assetName;

                    document.getElementById('historyAssetCode').textContent =
                        assetCode;


                    // Reset UI
                    document.getElementById('historyLoading')
                        .classList.remove('d-none');

                    document.getElementById('historyEmpty')
                        .classList.add('d-none');

                    document.getElementById('historyContent')
                        .classList.add('d-none');

                    document.getElementById('historyTableBody')
                        .innerHTML = '';


                    // Open modal immediately
                    historyModal.show();


                    try {

                        const response =
                            await fetch(
                                `/Admin/GetAssetHistory?assetId=${assetId}`
                            );


                        if (!response.ok) {

                            throw new Error(
                                'Unable to load asset history.'
                            );

                        }


                        const result =
                            await response.json();


                        document.getElementById('historyLoading')
                            .classList.add('d-none');


                        if (!result.success ||
                            !result.history ||
                            result.history.length === 0) {

                            document.getElementById('historyEmpty')
                                .classList.remove('d-none');

                            return;
                        }


                        const tbody =
                            document.getElementById('historyTableBody');


                        result.history.forEach(function (item) {

                            const row =
                                document.createElement('tr');


                            row.innerHTML = `

                                <td>
                                    <span class="history-date">
                                        ${escapeHtml(item.performedDate || '')}
                                    </span>
                                </td>

                                <td>
                                    <span class="history-action">
                                        <i class="bi bi-clock-history"></i>
                                        ${escapeHtml(item.action || '')}
                                    </span>
                                </td>

                                <td>
                                    <div class="history-value">
                                        ${escapeHtml(item.oldValue || '-')}
                                    </div>
                                </td>

                                <td>
                                    <div class="history-value">
                                        ${escapeHtml(item.newValue || '-')}
                                    </div>
                                </td>

                                <td>
                                    <div class="history-remarks">
                                        ${escapeHtml(item.remarks || '-')}
                                    </div>
                                </td>

                                <td>
                                    <span class="history-user">
                                        ${escapeHtml(item.performedBy || '-')}
                                    </span>
                                </td>

                            `;

                            tbody.appendChild(row);

                        });


                        document.getElementById('historyContent')
                            .classList.remove('d-none');


                    }
                    catch (error) {

                        console.error(
                            'Asset history error:',
                            error
                        );

                        document.getElementById('historyLoading')
                            .classList.add('d-none');

                        document.getElementById('historyEmpty')
                            .classList.remove('d-none');

                    }

                });

            });


            // Prevent HTML injection
            function escapeHtml(value) {

                const div =
                    document.createElement('div');

                div.textContent =
                    value ?? '';

                return div.innerHTML;

            }

        });
</script>