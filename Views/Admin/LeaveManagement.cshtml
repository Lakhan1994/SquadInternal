@model List<SquadInternal.Models.EmployeeLeave>

@{
    ViewData["Title"] = "Leave Management";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";

    var employees = ViewBag.EmployeeList as List<SquadInternal.Models.Employee>;
    int? selectedId = ViewBag.SelectedEmployeeId as int?;
    var adminUserId = Context.Session.GetInt32("UserId");
    string? selectedStatus = ViewBag.SelectedStatus as string;
    string? fromDateVal = ViewBag.FromDate as string;
    string? toDateVal = ViewBag.ToDate as string;
}

<style>
    .leave-stat-card {
        border: none;
        border-radius: 14px;
        padding: 1.1rem 1.25rem;
        color: #fff;
        position: relative;
        overflow: hidden;
        box-shadow: 0 4px 14px rgba(0,0,0,.08);
    }
    .leave-stat-card .stat-icon {
        position: absolute;
        right: 14px;
        top: 14px;
        font-size: 2rem;
        opacity: .35;
    }
    .leave-stat-card .stat-value {
        font-size: 1.8rem;
        font-weight: 700;
        line-height: 1;
    }
    .leave-stat-card .stat-label {
        font-size: .85rem;
        opacity: .9;
        margin-top: .25rem;
    }
    .stat-total { background: linear-gradient(135deg,#4e73df,#3f5fc4); }
    .stat-approved { background: linear-gradient(135deg,#1cc88a,#17a673); }
    .stat-pending { background: linear-gradient(135deg,#f6c23e,#dda520); }
    .stat-rejected { background: linear-gradient(135deg,#e74a3b,#c0392b); }

    .filter-pill {
        border-radius: 20px !important;
        padding: .35rem 1rem;
        font-size: .85rem;
        font-weight: 500;
    }

    .leave-tabs .nav-link {
        border: none;
        border-bottom: 3px solid transparent;
        border-radius: 0;
        font-weight: 600;
        color: #6c757d;
        padding: .6rem 1.1rem;
    }
    .leave-tabs .nav-link.active {
        color: #4e73df;
        border-bottom-color: #4e73df;
        background: transparent;
    }

    .leave-table thead th {
        font-size: .78rem;
        text-transform: uppercase;
        letter-spacing: .04em;
        color: #6c757d;
        border-bottom-width: 1px;
    }
    .leave-table tbody tr:hover {
        background-color: #f8f9fc;
    }
    .avatar-badge {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        background: #eef1fb;
        color: #4e73df;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-weight: 600;
        font-size: .8rem;
        margin-right: .5rem;
    }
    .leave-action-buttons {
        display: flex;
        flex-wrap: wrap;
        gap: .4rem;
    }
    .leave-modal-content {
        border: 0;
        border-radius: 14px;
        overflow: hidden;
        box-shadow: 0 20px 60px rgba(0, 0, 0, .15);
    }
    .leave-modal-header {
        padding: 1.1rem 1.5rem;
        background: linear-gradient(135deg, #f8f9ff 0%, #fff 100%);
        border-bottom: 1px solid #edf0f4;
    }
    .leave-modal-title { color: #2c3e50; font-weight: 700; }
    .leave-modal-body { padding: 1.5rem; }
    .leave-modal-footer {
        padding: 1rem 1.5rem;
        background: #f8f9fa;
        border-top: 1px solid #edf0f4;
    }
    .leave-form-label {
        color: #344054;
        font-size: .88rem;
        font-weight: 600;
        margin-bottom: .4rem;
    }
    .leave-form-control { border: 1px solid #d9e0e8; border-radius: 8px; padding: .6rem .75rem; }
    .leave-form-control:focus {
        border-color: #4e73df;
        box-shadow: 0 0 0 3px rgba(78, 115, 223, .12);
    }
</style>

<div class="page-accent d-flex justify-content-between align-items-center flex-wrap gap-2">
    <h3 class="m-0"><i class="bi bi-calendar-check me-2"></i>Leave Management</h3>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-info" asp-action="MonthlySummary">
            <i class="bi bi-calendar-month"></i> Monthly Summary
        </a>
        <a class="btn btn-outline-success"
           href="@Url.Action("DownloadLeaveReport", new { employeeId = selectedId, status = selectedStatus, fromDate = fromDateVal, toDate = toDateVal })">
            <i class="bi bi-download"></i> Download Report
        </a>
    </div>
</div>

<!-- ================= STAT CARDS ================= -->
<div class="row g-3 mt-1">
    <div class="col-6 col-md-3">
        <div class="leave-stat-card stat-total">
            <i class="bi bi-list-check stat-icon"></i>
            <div class="stat-value">@(((decimal)ViewBag.TotalRequestedDays).ToString("0.##"))</div>
            <div class="stat-label">Days Requested</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="leave-stat-card stat-approved">
            <i class="bi bi-check-circle stat-icon"></i>
            <div class="stat-value">@(((decimal)ViewBag.ApprovedDays).ToString("0.##"))</div>
            <div class="stat-label">Approved Days</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="leave-stat-card stat-pending">
            <i class="bi bi-hourglass-split stat-icon"></i>
            <div class="stat-value">@ViewBag.PendingCount</div>
            <div class="stat-label">Pending</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="leave-stat-card stat-rejected">
            <i class="bi bi-x-circle stat-icon"></i>
            <div class="stat-value">@ViewBag.RejectedCount</div>
            <div class="stat-label">Rejected</div>
        </div>
    </div>
</div>

<!-- ================= FILTERS ================= -->
<div class="card shadow-sm border-0 p-3 mt-3">
    <form method="get">
        <div class="row align-items-end g-2">
            <div class="col-md-4">
                <label class="form-label small text-muted mb-1">Employee</label>
                <select name="employeeId" class="form-select">
                    <option value="">-- All Employees --</option>
                    @if (employees != null)
                    {
                        foreach (var emp in employees)
                        {
                            <option value="@emp.Id" selected="@(selectedId == emp.Id)">
                                @emp.FirstName @emp.LastName
                            </option>
                        }
                    }
                </select>
            </div>
            <div class="col-6 col-md-3">
                <label class="form-label small text-muted mb-1">From Date</label>
                <input type="date" name="fromDate" class="form-control" value="@fromDateVal" />
            </div>
            <div class="col-6 col-md-3">
                <label class="form-label small text-muted mb-1">To Date</label>
                <input type="date" name="toDate" class="form-control" value="@toDateVal" />
            </div>
            <input type="hidden" name="status" value="@selectedStatus" />
            <div class="col-md-2">
                <button class="btn btn-primary w-100">
                    <i class="bi bi-funnel"></i> Filter
                </button>
            </div>
        </div>

        <div class="d-flex flex-wrap gap-2 mt-3">
            <a class="btn filter-pill @(string.IsNullOrEmpty(selectedStatus) ? "btn-secondary" : "btn-outline-secondary")"
               href="@Url.Action("LeaveManagement", new { employeeId = selectedId, fromDate = fromDateVal, toDate = toDateVal })">
                All Requests
            </a>
            <a class="btn filter-pill @(selectedStatus == "Pending" ? "btn-warning" : "btn-outline-warning")"
               href="@Url.Action("LeaveManagement", new { employeeId = selectedId, status = "Pending", fromDate = fromDateVal, toDate = toDateVal })">
                <i class="bi bi-hourglass-split"></i> Pending
            </a>
            <a class="btn filter-pill @(selectedStatus == "Approved" ? "btn-success" : "btn-outline-success")"
               href="@Url.Action("LeaveManagement", new { employeeId = selectedId, status = "Approved", fromDate = fromDateVal, toDate = toDateVal })">
                <i class="bi bi-check-circle"></i> Approved
            </a>
            <a class="btn filter-pill @(selectedStatus == "Rejected" ? "btn-danger" : "btn-outline-danger")"
               href="@Url.Action("LeaveManagement", new { employeeId = selectedId, status = "Rejected", fromDate = fromDateVal, toDate = toDateVal })">
                <i class="bi bi-x-circle"></i> Rejected
            </a>
        </div>
    </form>
</div>

<ul class="nav nav-tabs leave-tabs mt-4" role="tablist">
    <li class="nav-item">
        <button class="nav-link @(TempData["Error"] != null ? "" : "active")"
                data-bs-toggle="tab"
                data-bs-target="#approvals">

            <i class="bi bi-card-checklist me-1"></i> Leave Approvals
        </button>
    </li>
    <li class="nav-item">
        <button class="nav-link @(TempData["Error"] != null ? "active" : "")"
                data-bs-toggle="tab"
                data-bs-target="#myLeaves">

            <i class="bi bi-person-lines-fill me-1"></i> My Leaves

        </button>
    </li>
   
</ul>

<div class="tab-content mt-3">

    <!-- ================= APPROVALS TAB ================= -->
    <div class="tab-pane fade @(TempData["Error"] == null ? "show active" : "")" id="approvals">

        <div class="card shadow-sm border-0">
            <div class="table-responsive">
                <table class="table table-hover leave-table mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Employee</th>
                            <th>Type</th>
                            <th>From</th>
                            <th>To</th>
                            <th>Days</th>
                            <th>Status</th>
                            <th style="width:120px;">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Any())
                        {
                            foreach (var leave in Model)
                            {
                                string badgeClass = leave.Status == "Approved" ? "bg-success"
                                : leave.Status == "Pending" ? "bg-warning text-dark"
                                : "bg-danger";

                                var initials = $"{leave.Employee?.FirstName?.FirstOrDefault()}{leave.Employee?.LastName?.FirstOrDefault()}".ToUpper();
                                var totalDays = (leave.ToDate.Date - leave.FromDate.Date).Days + 1;

                                <tr>
                                    <td>
                                        <span class="avatar-badge">@initials</span>
                                        @leave.Employee?.FirstName @leave.Employee?.LastName
                                    </td>
                                    <td>@leave.LeaveType</td>
                                    <td>@leave.FromDate.ToString("dd MMM yyyy")</td>
                                    <td>@leave.ToDate.ToString("dd MMM yyyy")</td>
                                    <td>@totalDays</td>
                                    <td>
                                        <span class="badge @badgeClass">
                                            @leave.Status
                                        </span>
                                    </td>
                                    <td>
                                        @if (leave.Status == "Pending")
                                        {
                                            <div class="leave-action-buttons">
                                            <form asp-action="ApproveLeave" method="post">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@leave.Id" />
                                                <button type="submit" class="btn btn-sm btn-success icon-action-button" title="Approve leave" aria-label="Approve leave">
                                                    <i class="bi bi-check-lg" aria-hidden="true"></i>
                                                </button>
                                            </form>
                                                <button type="button" class="btn btn-sm btn-outline-danger icon-action-button" title="Reject leave" aria-label="Reject leave"
                                                    data-bs-toggle="modal" data-bs-target="#leaveReasonModal"
                                                    data-action="@Url.Action("RejectLeave")"
                                                    data-leave-id="@leave.Id" data-reason-name="rejectionReason"
                                                    data-modal-title="Reject Leave" data-submit-label="Reject Leave">
                                                <i class="bi bi-x-lg" aria-hidden="true"></i>
                                            </button>
                                            </div>
                                        }
                                        else if (leave.Status == "Approved")
                                        {
                                            <button type="button" class="btn btn-sm btn-outline-danger icon-action-button" title="Cancel approved leave" aria-label="Cancel approved leave"
                                                    data-bs-toggle="modal" data-bs-target="#leaveReasonModal"
                                                    data-action="@Url.Action("CancelApprovedLeave")"
                                                    data-leave-id="@leave.Id" data-reason-name="reason"
                                                    data-modal-title="Cancel Approved Leave" data-submit-label="Cancel Leave">
                                                <i class="bi bi-x-circle" aria-hidden="true"></i>
                                            </button>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">No Action</span>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="empty-state">
                                    <i class="bi bi-inbox fs-3 d-block mb-2"></i>
                                    No leave requests found.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div> 

    <!-- ================= MY LEAVES TAB ================= -->
    <div class="tab-pane fade @(TempData["Error"] != null ? "show active" : "")" id="myLeaves">


        <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="m-0"><i class="bi bi-clock-history me-1"></i>My Leave History</h5>

            <button class="btn btn-primary"
                    data-bs-toggle="modal"
                    data-bs-target="#adminApplyLeaveModal">
                <i class="bi bi-plus-lg"></i> Apply Leave
            </button>
        </div>

        <div class="card shadow-sm border-0">
            <div class="table-responsive">
                <table class="table table-hover leave-table mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Type</th>
                            <th>From</th>
                            <th>To</th>
                            <th>Status</th>
                            <th style="width:120px;">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            var myLeaves = Model
                            .Where(l => l.Employee != null &&
                            l.Employee.UserId == adminUserId)
                            .ToList();
                        }

                        @if (myLeaves.Any())
                        {
                            foreach (var leave in myLeaves)
                            {
                                string badgeClass = leave.Status == "Approved" ? "bg-success"
                                : leave.Status == "Pending" ? "bg-warning text-dark"
                                : "bg-danger";

                                <tr>
                                    <td>@leave.LeaveType</td>
                                    <td>@leave.FromDate.ToString("dd MMM yyyy")</td>
                                    <td>@leave.ToDate.ToString("dd MMM yyyy")</td>
                                    <td>
                                        <span class="badge @badgeClass">@leave.Status</span>
                                    </td>
                                    <td>
                                        @if (leave.Status == "Pending")
                                        {
                                            <form asp-action="CancelLeave" method="post">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@leave.Id" />
                                                <button type="submit" class="btn btn-sm btn-outline-danger icon-action-button" title="Withdraw leave request" aria-label="Withdraw leave request">
                                                    <i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i>
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">No Action</span>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="empty-state">
                                    <i class="bi bi-inbox fs-3 d-block mb-2"></i>
                                    No leaves applied yet.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

    </div> 

  

    </div>

<!-- ================= ADMIN APPLY LEAVE MODAL ================= -->
<div class="modal fade" id="adminApplyLeaveModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content leave-modal-content">
            <form asp-action="ApplyAdminLeave" method="post" autocomplete="off">
                @Html.AntiForgeryToken()

                <div class="modal-header leave-modal-header">
                    <h5 class="modal-title leave-modal-title"><i class="bi bi-calendar-plus me-2 text-primary"></i>Apply Leave</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <div class="modal-body leave-modal-body">

                    <div class="mb-3">
                        <label for="adminLeaveType" class="leave-form-label">Leave Type</label>
                        <select id="adminLeaveType" name="LeaveType" class="form-select leave-form-control" required>
                            <option value="Sick Leave">Sick Leave</option>
                            <option value="Casual Leave">Casual Leave</option>
                            <option value="Paternity Leave">Paternity Leave</option>
                            <option value="Maternity Leave">Maternity Leave</option>
                        </select>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-sm-6">
                            <label for="adminLeaveFromDate" class="leave-form-label">From Date</label>
                            <input type="date" id="adminLeaveFromDate" name="FromDate" class="form-control leave-form-control" min="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                        </div>
                        <div class="col-sm-6">
                            <label for="adminLeaveToDate" class="leave-form-label">To Date</label>
                            <input type="date" id="adminLeaveToDate" name="ToDate" class="form-control leave-form-control" min="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label for="adminLeaveDuration" class="leave-form-label">Duration</label>
                        <select id="adminLeaveDuration" name="Duration" class="form-select leave-form-control" required>
                            <option value="Full Day">Full Day</option>
                            <option value="First Half">First Half</option>
                            <option value="Second Half">Second Half</option>
                        </select>
                    </div>

                    <div id="adminLeaveDateWarning" class="alert alert-warning py-2 small d-none" role="alert"></div>

                    <div class="mb-3">
                        <label for="adminLeaveReason" class="leave-form-label">Reason</label>
                        <textarea id="adminLeaveReason" name="Reason" class="form-control leave-form-control" rows="3" maxlength="1000" placeholder="Briefly describe the reason for your leave..." required></textarea>
                    </div>

                </div>

                <div class="modal-footer leave-modal-footer">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary"><i class="bi bi-send me-1"></i>Apply Leave</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="leaveReasonModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content leave-modal-content">
            <form id="leaveReasonForm" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" id="leaveReasonId" name="id" />
                <div class="modal-header leave-modal-header">
                    <h5 class="modal-title leave-modal-title" id="leaveReasonTitle">Leave Action</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body leave-modal-body">
                    <label for="leaveReasonInput" class="leave-form-label">Reason</label>
                    <textarea id="leaveReasonInput" class="form-control leave-form-control" rows="3" maxlength="500" placeholder="Enter a reason..." required></textarea>
                </div>
                <div class="modal-footer leave-modal-footer">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger" id="leaveReasonSubmit">Continue</button>
                </div>
            </form>
        </div>
    </div>
</div>

@if (TempData["Error"] != null)
{
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            var myModal = new bootstrap.Modal(document.getElementById('adminApplyLeaveModal'));
            myModal.show();
        });
    </script>
}
<script>
    const blockedDates = [
        @if (ViewBag.BlockedLeaveDates != null)
        {
                foreach (DateTime date in ViewBag.BlockedLeaveDates)
                {
                        @:new Date("@date.ToString("yyyy-MM-dd")"),
                }
        }
    ];

    function isBlocked(date) {
        return blockedDates.some(d =>
            d.getFullYear() === date.getFullYear() &&
            d.getMonth() === date.getMonth() &&
            d.getDate() === date.getDate()
        );
    }

    const leaveReasonModal = document.getElementById("leaveReasonModal");
    leaveReasonModal.addEventListener("show.bs.modal", function (event) {
        const trigger = event.relatedTarget;
        const form = document.getElementById("leaveReasonForm");
        const reasonInput = document.getElementById("leaveReasonInput");

        form.action = trigger.dataset.action;
        document.getElementById("leaveReasonId").value = trigger.dataset.leaveId;
        reasonInput.name = trigger.dataset.reasonName;
        reasonInput.value = "";
        document.getElementById("leaveReasonTitle").textContent = trigger.dataset.modalTitle;
        document.getElementById("leaveReasonSubmit").textContent = trigger.dataset.submitLabel;
    });

    const fromInput = document.getElementById("adminLeaveFromDate");
    const toInput = document.getElementById("adminLeaveToDate");
    const durationInput = document.getElementById("adminLeaveDuration");
    const dateWarning = document.getElementById("adminLeaveDateWarning");
    const applyButton = document.querySelector("#adminApplyLeaveModal button[type='submit']");

    function checkDateSelection() {
        if (!fromInput.value || !toInput.value) {
            dateWarning.classList.add("d-none");
            applyButton.disabled = false;
            return;
        }

        const fromDate = new Date(`${fromInput.value}T00:00:00`);
        const toDate = new Date(`${toInput.value}T00:00:00`);
        let warning = toDate < fromDate ? "To Date must be on or after From Date." : "";

        if (!warning && durationInput.value !== "Full Day" && fromInput.value !== toInput.value) {
            warning = "Half-day leave must be for a single date.";
        }

        for (let date = new Date(fromDate); !warning && date <= toDate; date.setDate(date.getDate() + 1)) {
            if (isBlocked(date)) warning = "The selected dates overlap with an existing leave request.";
        }

        dateWarning.textContent = warning;
        dateWarning.classList.toggle("d-none", !warning);
        applyButton.disabled = Boolean(warning);
    }

    fromInput.addEventListener("change", checkDateSelection);
    toInput.addEventListener("change", checkDateSelection);
    durationInput.addEventListener("change", checkDateSelection);
</script>
