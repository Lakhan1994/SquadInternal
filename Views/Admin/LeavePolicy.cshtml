@model SquadInternal.Models.AnnualLeavePolicy

@{
    ViewData["Title"] = "Annual Leave Policy";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    var employees = ViewBag.ActiveEmployees as List<SquadInternal.Models.Employee> ?? new();
    var execution = ViewBag.RolloverExecution as SquadInternal.Models.LeaveRolloverExecution;
    var pendingBonuses = ViewBag.PendingBonuses as List<SquadInternal.Models.LeaveBalanceTransaction> ?? new();
}

<div class="page-accent d-flex justify-content-between align-items-center flex-wrap gap-2">
    <h3 class="m-0"><i class="bi bi-sliders me-2"></i>Annual Leave Policy</h3>
    <div class="d-flex flex-column flex-sm-row gap-2">
        <a asp-action="NewLeavePolicy" class="btn btn-outline-primary">New future policy</a>
        <a asp-action="LeaveManagement" class="btn btn-outline-secondary">Leave Management</a>
    </div>
</div>

@if (TempData["Success"] is string success)
{
    <div class="alert alert-success mt-3">@success</div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger mt-3">@error</div>
}

<form asp-action="SaveLeavePolicy" method="post" class="card shadow-sm border-0 p-3 mt-3">
    @Html.AntiForgeryToken()
    <input asp-for="Id" type="hidden" />
    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

    <div class="row g-3">
        <div class="col-md-4">
            <label asp-for="EffectiveFrom" class="form-label">Effective from</label>
            <input asp-for="EffectiveFrom" type="date" class="form-control" />
        </div>
        <div class="col-md-4">
            <label asp-for="CasualLeaveDays" class="form-label">Annual Casual Leave (days)</label>
            <input asp-for="CasualLeaveDays" type="number" class="form-control" readonly />
        </div>
        <div class="col-md-4">
            <label asp-for="SickLeaveDays" class="form-label">Annual Sick Leave (days)</label>
            <input asp-for="SickLeaveDays" type="number" class="form-control" readonly />
        </div>
        <div class="col-12">
            <div class="alert alert-info mb-0">Monthly accrual: 0.5 EL/PL + 0.25 SL + 0.25 CL. A full eligible year totals 12 days. EL/PL can be disabled for a policy version; historical balances are not rewritten.</div>
        </div>
        <div class="col-md-4">
            <div class="form-check mt-4">
                <input asp-for="EarnedLeaveEnabled" class="form-check-input" />
                <label asp-for="EarnedLeaveEnabled" class="form-check-label">Activate EL/PL</label>
            </div>
        </div>
        <div class="col-md-4">
            <label asp-for="EarnedLeaveDays" class="form-label">Annual EL/PL allocation</label>
            <input asp-for="EarnedLeaveDays" type="number" class="form-control" readonly />
        </div>
        <div class="col-md-4"><div class="alert alert-light mt-4 mb-0">Accrual starts on the joining month only when joining on day 1; otherwise it starts the following month.</div></div>

        <div class="col-12"><hr class="my-2" /><h5 class="mb-0">Year-end bonus</h5></div>
        <div class="col-md-3"><div class="form-check"><input asp-for="CasualLeaveBonusEligible" class="form-check-input" /><label asp-for="CasualLeaveBonusEligible" class="form-check-label">Unused CL qualifies</label></div></div>
        <div class="col-md-3"><div class="form-check"><input asp-for="SickLeaveBonusEligible" class="form-check-input" /><label asp-for="SickLeaveBonusEligible" class="form-check-label">Unused SL qualifies</label></div></div>
        <div class="col-md-3"><div class="form-check"><input asp-for="BonusUsesSeparateCategory" class="form-check-input" /><label asp-for="BonusUsesSeparateCategory" class="form-check-label">Separate bonus category</label></div></div>
        <div class="col-md-3"><div class="form-check"><input asp-for="BonusRequiresApproval" class="form-check-input" /><label asp-for="BonusRequiresApproval" class="form-check-label">Bonus requires approval</label></div></div>
        <div class="col-md-3"><label asp-for="BonusConversionRate" class="form-label">Conversion rate</label><input asp-for="BonusConversionRate" type="number" min="0" step="0.1" class="form-control" /></div>
        <div class="col-md-3"><label asp-for="BonusMaxEligibleUnusedDays" class="form-label">Max eligible unused days</label><input asp-for="BonusMaxEligibleUnusedDays" type="number" min="0" step="0.5" class="form-control" /></div>
        <div class="col-md-3"><label asp-for="BonusMaxDaysPerEmployeeYear" class="form-label">Max bonus days per employee/year</label><input asp-for="BonusMaxDaysPerEmployeeYear" type="number" min="0" step="0.5" class="form-control" /></div>
        <div class="col-md-3"><label asp-for="BonusExpirationMonths" class="form-label">Bonus expires after (months)</label><input asp-for="BonusExpirationMonths" type="number" min="1" class="form-control" /></div>
        <div class="col-md-4"><div class="form-check"><input asp-for="CarryForwardUnusedLeave" class="form-check-input" /><label asp-for="CarryForwardUnusedLeave" class="form-check-label">Carry forward unused balances</label></div></div>
        <div class="col-md-4"><label asp-for="BusinessTimeZoneId" class="form-label">Business time zone ID</label><input asp-for="BusinessTimeZoneId" class="form-control" /></div>
        <div class="col-md-12"><label asp-for="ChangeReason" class="form-label">Change reason</label><textarea asp-for="ChangeReason" class="form-control" maxlength="500" required></textarea></div>
        <div class="col-12 d-flex justify-content-end"><button type="submit" class="btn btn-primary"><i class="bi bi-save me-1"></i>Save policy</button></div>
    </div>
</form>

<section class="card shadow-sm border-0 p-3 mt-3">
    <h5 class="mb-3">Pending bonus credits</h5>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light"><tr><th>Employee</th><th>Year</th><th>Category</th><th>Days</th><th>Expires</th><th>Action</th></tr></thead>
            <tbody>
                @if (pendingBonuses.Count == 0)
                {
                    <tr><td colspan="6" class="text-muted">No bonus credits awaiting approval.</td></tr>
                }
                else
                {
                    foreach (var bonus in pendingBonuses)
                    {
                        <tr>
                            <td>@bonus.Employee?.FirstName @bonus.Employee?.LastName</td>
                            <td>@bonus.LeaveYear</td>
                            <td>@bonus.LeaveType</td>
                            <td>@bonus.Days.ToString("0.##")</td>
                            <td>@(bonus.ExpiresOn?.ToString("dd MMM yyyy") ?? "No expiry")</td>
                            <td><form asp-action="ApproveBonusCredit" method="post">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@bonus.Id" /><button class="btn btn-sm btn-success">Approve credit</button></form></td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</section>

<section class="card shadow-sm border-0 p-3 mt-3">
    <h5 class="mb-2">Annual processing</h5>
    <p class="text-muted mb-3">Latest run: @(execution == null ? "Not processed" : $"{execution.LeaveYear}: {execution.Status} ({execution.StartedOn.ToLocalTime():g})")</p>
    @if (!string.IsNullOrWhiteSpace(execution?.Error))
    {
        <div class="alert alert-warning">The latest run failed. Review the application log before retrying.</div>
    }
    <form asp-action="ProcessLeaveRollover" method="post" class="row g-2 align-items-end">
        @Html.AntiForgeryToken()
        <div class="col-auto"><label for="rolloverYear" class="form-label">Leave year</label><input id="rolloverYear" name="year" type="number" min="2027" value="@DateTime.UtcNow.Year" class="form-control" /></div>
        <div class="col-auto"><button type="submit" class="btn btn-outline-primary">Process or retry rollover</button></div>
    </form>
</section>

<section class="card shadow-sm border-0 p-3 mt-3">
    <h5 class="mb-3">Manual balance adjustment</h5>
    <form asp-action="AdjustLeaveBalance" method="post" class="row g-3">
        @Html.AntiForgeryToken()
        <input type="hidden" name="adjustmentKey" value="@ViewBag.AdjustmentKey" />
        <div class="col-md-4"><label class="form-label">Employee</label><select name="employeeId" class="form-select" required><option value="">Select employee</option>@foreach (var employee in employees) { <option value="@employee.Id">@employee.FirstName @employee.LastName</option> }</select></div>
        <div class="col-md-2"><label class="form-label">Leave year</label><input name="leaveYear" type="number" min="2027" value="@DateTime.UtcNow.Year" class="form-control" required /></div>
        <div class="col-md-2"><label class="form-label">Category</label><select name="leaveType" class="form-select"><option>Casual Leave</option><option>Sick Leave</option><option>Earned Leave</option>@if (Model.BonusUsesSeparateCategory) { <option>Bonus Leave</option> }</select></div>
        <div class="col-md-2"><label class="form-label">Days (+/-)</label><input name="days" type="number" step="0.5" class="form-control" required /></div>
        <div class="col-md-12"><label class="form-label">Reason</label><input name="reason" maxlength="500" class="form-control" required /></div>
        <div class="col-12 d-flex justify-content-end"><button type="submit" class="btn btn-outline-primary">Record adjustment</button></div>
    </form>
</section>
