@{
    ViewData["Title"] = "Login";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] · Squad Logic</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=DM+Serif+Display&display=swap" rel="stylesheet">
    <style>
            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }

            body {
                background: #eef1f7;
                font-family: 'Inter', 'Segoe UI', sans-serif;
                min-height: 100vh;
                display: flex;
                align-items: center;
                justify-content: center;
                padding: 1.5rem;
            }

            .login-wrapper {
                width: 100%;
                max-width: 1200px;
            }

            .login-container {
                display: flex;
                border-radius: 28px;
                overflow: hidden;
                background: #ffffff;
                box-shadow: 0 30px 60px rgba(0, 0, 0, 0.10);
            }

            .left-panel {
                width: 60%;
                background: linear-gradient(135deg, #f8f9ff 0%, #eef1f7 100%);
                padding: 50px 40px 40px;
                display: flex;
                flex-direction: column;
                align-items: center;
                justify-content: center;
                text-align: center;
                position: relative;
            }

            .logo-container {
                margin-bottom: 20px;
            }

            .logo-text {
                font-weight: 800;
                font-size: 36px;
                letter-spacing: 3px;
                color: #1a1e2b;
                text-transform: uppercase;
                background: linear-gradient(135deg, #4a58c9, #6f7cff);
                -webkit-background-clip: text;
                -webkit-text-fill-color: transparent;
                background-clip: text;
            }

            .logo-tagline {
                font-weight: 600;
                font-size: 14px;
                letter-spacing: 6px;
                color: #6b7280;
                text-transform: uppercase;
                margin-top: 2px;
                -webkit-text-fill-color: #6b7280;
            }

                .logo-tagline span {
                    color: #6f7cff;
                    -webkit-text-fill-color: #6f7cff;
                }

            .left-panel h2 {
                font-weight: 700;
                font-size: 28px;
                letter-spacing: -0.3px;
                color: #1a1e2b;
                margin-bottom: 4px;
            }

            .left-panel .subhead {
                color: #6b7280;
                font-size: 15px;
                font-weight: 400;
                margin-bottom: 20px;
            }

            .illustration {
                max-width: 70%;
                height: auto;
                margin-top: 10px;
                filter: drop-shadow(0 12px 18px rgba(0, 0, 0, 0.06));
                display: block;
            }

            .left-panel .watermark {
                position: absolute;
                bottom: 28px;
                left: 50%;
                transform: translateX(-50%);
                width: 60%;
                height: 90px;
                background: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 200 40"><text x="0" y="28" font-family="Inter, sans-serif" font-weight="800" font-size="22" fill="%23d0d5e0" opacity="0.2">SQUAD LOGIC</text></svg>') no-repeat center;
                background-size: contain;
                pointer-events: none;
            }

            .right-panel {
                width: 40%;
                background: linear-gradient(145deg, #6f7cff, #4a58c9);
                display: flex;
                justify-content: center;
                align-items: center;
                padding: 2rem 1.5rem;
                position: relative;
                overflow: hidden;
            }

                .right-panel::before {
                    content: '';
                    position: absolute;
                    top: -50%;
                    right: -50%;
                    width: 200%;
                    height: 200%;
                    background: radial-gradient(circle at 70% 30%, rgba(255,255,255,0.05) 0%, transparent 70%);
                    pointer-events: none;
                }

                .right-panel::after {
                    content: 'SL';
                    position: absolute;
                    bottom: 20px;
                    right: 20px;
                    font-size: 80px;
                    font-weight: 800;
                    color: rgba(255,255,255,0.04);
                    letter-spacing: -5px;
                    pointer-events: none;
                }

            .login-card {
                background: #ffffff;
                padding: 2.2rem 2rem 2rem;
                border-radius: 20px;
                width: 100%;
                max-width: 380px;
                box-shadow: 0 20px 40px rgba(0, 0, 0, 0.25);
                transform: translateX(-20px);
                transition: transform 0.2s ease;
                position: relative;
                z-index: 1;
            }

                .login-card h5 {
                    font-weight: 700;
                    font-size: 20px;
                    color: #111827;
                    margin-bottom: 4px;
                    text-align: center;
                }

                .login-card .secure-text {
                    color: #6b7280;
                    font-size: 13px;
                    text-align: center;
                    margin-bottom: 24px;
                    line-height: 1.4;
                }

            .form-group {
                margin-bottom: 1.1rem;
                position: relative;
            }

            .custom-input {
                width: 100%;
                padding: 12px 16px;
                border-radius: 12px;
                border: 1px solid #e5e7eb;
                font-size: 14px;
                font-weight: 500;
                background: #f9fafb;
                transition: 0.2s ease;
                outline: none;
                color: #111827;
            }

                .custom-input:focus {
                    border-color: #6f7cff;
                    background: #ffffff;
                    box-shadow: 0 0 0 4px rgba(108, 122, 224, 0.15);
                }

                .custom-input.is-invalid {
                    border-color: #e53e3e;
                    background: #fff5f5;
                }

            .invalid-feedback {
                display: none;
                color: #e53e3e;
                font-size: 12px;
                font-weight: 500;
                margin-top: 4px;
                margin-left: 4px;
            }

                .invalid-feedback.show {
                    display: block;
                }

            .toggle-eye {
                position: absolute;
                right: 16px;
                top: 50%;
                transform: translateY(-50%);
                cursor: pointer;
                color: #9ca3af;
                font-size: 1.2rem;
                transition: color 0.2s;
                z-index: 5;
                background: transparent;
                border: none;
                padding: 0;
            }

                .toggle-eye:hover {
                    color: #4b5563;
                }

            .forgot-link {
                text-align: right;
                margin-top: -4px;
                margin-bottom: 18px;
            }

                .forgot-link a {
                    font-size: 13px;
                    font-weight: 500;
                    color: #6f7cff;
                    text-decoration: none;
                }

                    .forgot-link a:hover {
                        text-decoration: underline;
                        color: #4f5bd5;
                    }

            .btn-login {
                background: linear-gradient(135deg, #6f7cff, #4a58c9);
                color: white;
                border: none;
                border-radius: 12px;
                padding: 13px;
                font-weight: 600;
                font-size: 15px;
                width: 100%;
                transition: 0.2s;
                box-shadow: 0 8px 18px rgba(90, 103, 216, 0.25);
                cursor: pointer;
            }

                .btn-login:hover {
                    transform: translateY(-2px);
                    box-shadow: 0 12px 24px rgba(90, 103, 216, 0.35);
                    background: linear-gradient(135deg, #5f6de6, #3d4ab5);
                }

                .btn-login:active {
                    transform: scale(0.97);
                }

            .register-row {
                text-align: center;
                margin-top: 18px;
                font-size: 13px;
                color: #4b5563;
            }

                .register-row a {
                    font-weight: 600;
                    color: #6f7cff;
                    text-decoration: none;
                    margin-left: 4px;
                }

                    .register-row a:hover {
                        text-decoration: underline;
                    }

            .alert-box {
                border-radius: 10px;
                padding: 8px 12px;
                font-size: 13px;
                margin-bottom: 16px;
                display: none;
            }

                .alert-box.show {
                    display: block;
                }

                .alert-box.error {
                    background: #fee2e2;
                    color: #b91c1c;
                    border-left: 4px solid #b91c1c;
                }

                .alert-box.success {
                    background: #d1fae5;
                    color: #065f46;
                    border-left: 4px solid #065f46;
                }

            @@media (max-width: 820px) {
                .login-container {
                    flex-direction: column;
                    border-radius: 24px;
                }

                .left-panel, .right-panel {
                    width: 100%;
                }

                .left-panel {
                    padding: 30px 20px 30px;
                }

                    .left-panel .watermark {
                        display: none;
                    }

                .illustration {
                    max-width: 55%;
                    margin: 10px auto 0;
                }

                .right-panel {
                    padding: 2rem 1.5rem;
                }

                    .right-panel::after {
                        display: none;
                    }

                .login-card {
                    transform: translateX(0);
                    max-width: 100%;
                    padding: 1.8rem 1.5rem;
                }

                .left-panel h2 {
                    font-size: 26px;
                }

                .logo-text {
                    font-size: 28px;
                }
            }

            @@media (max-width: 480px) {
                .login-card {
                    padding: 1.5rem 1rem;
                }

                .left-panel h2 {
                    font-size: 22px;
                }

                .illustration {
                    max-width: 70%;
                }

                .logo-text {
                    font-size: 24px;
                }

                .logo-tagline {
                    font-size: 11px;
                    letter-spacing: 4px;
                }
            }
    </style>
    <style>
        :root {
            color-scheme: light;
            --auth-ink: var(--brand-primary);
            --auth-ink-deep: var(--brand-primary-deep);
            --auth-accent: var(--brand-accent);
            --auth-text: var(--brand-text);
            --auth-muted: var(--brand-muted);
            --auth-line: var(--brand-border);
            --auth-surface: var(--brand-surface);
        }

        body {
            min-height: 100svh;
            padding: 32px;
            background: var(--brand-page);
            color: var(--auth-text);
            font-family: 'DM Sans', 'Segoe UI', sans-serif;
        }

        .auth-page { width: 100%; max-width: 1080px; }
        .auth-shell {
            display: grid;
            grid-template-columns: minmax(0, .92fr) minmax(0, 1.08fr);
            min-height: 620px;
            overflow: hidden;
            border: 1px solid rgba(16, 45, 42, .08);
            border-radius: 8px;
            background: var(--auth-surface);
            box-shadow: 0 24px 70px rgba(23, 59, 55, .12);
        }

        .auth-brand-panel {
            position: relative;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            min-width: 0;
            padding: 46px 42px 32px;
            overflow: hidden;
            color: #fff;
            background-color: var(--auth-ink);
            background-image: linear-gradient(rgba(255,255,255,.045) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.045) 1px, transparent 1px);
            background-size: 42px 42px;
        }

        .auth-brand-panel::after {
            position: absolute;
            right: -100px;
            bottom: 92px;
            width: 300px;
            height: 1px;
            content: '';
            background: rgba(130, 188, 245, .7);
            transform: rotate(-45deg);
        }

        .auth-logo { display: block; width: min(100%, 330px); height: auto; }
        .auth-brand-copy { position: relative; z-index: 1; margin: auto 0; padding: 62px 0; }
        .auth-eyebrow {
            margin: 0 0 16px;
            color: var(--auth-accent);
            font-size: .72rem;
            font-weight: 700;
            letter-spacing: .16em;
            text-transform: uppercase;
        }
        .auth-brand-copy h1 {
            max-width: 390px;
            margin: 0;
            color: #fff;
            font-family: 'DM Serif Display', Georgia, serif;
            font-size: clamp(2.25rem, 4vw, 3.35rem);
            font-weight: 400;
            line-height: 1.08;
        }
        .auth-brand-rule { display: block; width: 52px; height: 4px; margin-top: 28px; background: var(--auth-accent); }
        .auth-brand-footer {
            position: relative;
            z-index: 1;
            display: flex;
            align-items: center;
            gap: 10px;
            color: rgba(255,255,255,.72);
            font-size: .75rem;
            font-weight: 600;
            letter-spacing: .1em;
            text-transform: uppercase;
        }
        .auth-brand-footer span { width: 7px; height: 7px; border-radius: 50%; background: var(--auth-accent); }

        .auth-main {
            display: flex;
            align-items: center;
            justify-content: center;
            min-width: 0;
            padding: 56px clamp(28px, 7vw, 82px);
        }
        .auth-form-wrap { width: 100%; max-width: 390px; }
        .auth-heading { margin-bottom: 34px; }
        .auth-heading .auth-eyebrow { margin-bottom: 10px; color: #2865a3; }
        .auth-heading h2 {
            margin: 0 0 8px;
            color: var(--auth-ink-deep);
            font-family: 'DM Serif Display', Georgia, serif;
            font-size: 2.35rem;
            font-weight: 400;
            line-height: 1.15;
        }
        .auth-heading p { margin: 0; color: var(--auth-muted); font-size: .95rem; }
        .auth-field { margin-bottom: 21px; }
        .auth-label { display: block; margin-bottom: 8px; color: #314541; font-size: .84rem; font-weight: 700; }
        .auth-input-wrap { position: relative; }
        .auth-input {
            display: block;
            width: 100%;
            min-height: 50px;
            padding: 12px 14px;
            border: 1px solid var(--auth-line);
            border-radius: 5px;
            outline: 0;
            background: #fff;
            color: var(--auth-text);
            font: inherit;
            font-size: .93rem;
            transition: border-color .18s ease, box-shadow .18s ease;
        }
        .auth-input::placeholder { color: #9aa6a1; }
        .auth-input:focus { border-color: #4b83c2; box-shadow: 0 0 0 3px rgba(75, 131, 194, .14); }
        .auth-input.is-invalid { border-color: #bc4b4b; background: #fffafa; }
        .auth-password-input { padding-right: 52px; }
        .auth-password-toggle {
            position: absolute;
            top: 50%;
            right: 8px;
            display: inline-grid;
            width: 36px;
            height: 36px;
            place-items: center;
            border: 0;
            border-radius: 4px;
            background: transparent;
            color: #687772;
            cursor: pointer;
            transform: translateY(-50%);
        }
        .auth-password-toggle:hover { background: #edf3fa; color: var(--auth-ink); }
        .auth-password-toggle:focus-visible, .auth-submit:focus-visible, .auth-forgot:focus-visible {
            outline: 3px solid rgba(75, 131, 194, .35);
            outline-offset: 2px;
        }
        .invalid-feedback { margin: 6px 2px 0; color: #a83232; font-size: .78rem; }
        .auth-options { display: flex; justify-content: flex-end; margin: -5px 0 25px; }
        .auth-forgot { color: #285f98; font-size: .84rem; font-weight: 700; text-decoration: none; }
        .auth-forgot:hover { color: var(--auth-ink-deep); text-decoration: underline; }
        .auth-submit {
            display: flex;
            width: 100%;
            min-height: 51px;
            align-items: center;
            justify-content: center;
            gap: 10px;
            border: 0;
            border-radius: 5px;
            background: var(--auth-ink);
            color: #fff;
            font: inherit;
            font-size: .94rem;
            font-weight: 700;
            cursor: pointer;
            transition: background .18s ease, transform .18s ease;
        }
        .auth-submit:hover { background: #205f9f; transform: translateY(-1px); }
        .auth-submit i { color: var(--auth-accent); }
        .auth-footer { margin: 34px 0 0; color: #89938f; font-size: .75rem; text-align: center; }
        .alert-box {
            display: block;
            margin: -14px 0 22px;
            padding: 11px 13px;
            border: 1px solid transparent;
            border-radius: 4px;
            font-size: .84rem;
        }
        .alert-box.error { border-color: #f0caca; background: #fff3f2; color: #982f2f; }
        .alert-box.success { border-color: #c9e2d0; background: #eff8f1; color: #27603a; }

        @@media (max-width: 760px) {
            body { align-items: flex-start; padding: 18px; }
            .auth-shell { grid-template-columns: 1fr; min-height: 0; }
            .auth-brand-panel { min-height: 190px; padding: 26px 28px 20px; }
            .auth-logo { width: min(100%, 245px); }
            .auth-brand-copy { padding: 30px 0 24px; }
            .auth-brand-copy h1 { max-width: 340px; font-size: 2rem; }
            .auth-brand-copy .auth-eyebrow { margin-bottom: 9px; }
            .auth-brand-rule { display: none; }
            .auth-brand-footer { font-size: .68rem; }
            .auth-main { padding: 40px clamp(24px, 7vw, 54px); }
            .auth-heading { margin-bottom: 28px; }
        }

        @@media (max-width: 420px) {
            body { padding: 10px; }
            .auth-brand-panel { min-height: 164px; padding: 20px 20px 16px; }
            .auth-logo { width: 215px; }
            .auth-brand-copy { padding: 23px 0 18px; }
            .auth-brand-copy h1 { font-size: 1.75rem; }
            .auth-main { padding: 32px 20px; }
            .auth-heading h2 { font-size: 2rem; }
            .auth-heading { margin-bottom: 25px; }
        }
    </style>
</head>
<body class="auth-document">

    <div class="auth-page">
        <main class="auth-shell">
            <section class="auth-brand-panel" aria-label="Squad Logic">
                <img class="auth-logo" src="/images/company-logo.png" alt="Squad Logic, Treat with Technology" />
                <div class="auth-brand-copy">
                    <p class="auth-eyebrow">Squad Internal</p>
                    <h1>People, connected.<br />Work, in motion.</h1>
                    <span class="auth-brand-rule" aria-hidden="true"></span>
                </div>
                <div class="auth-brand-footer"><span aria-hidden="true"></span>Private team access</div>
            </section>

            <section class="auth-main" aria-labelledby="loginHeading">
                <div class="auth-form-wrap">
                    <header class="auth-heading">
                        <p class="auth-eyebrow">Account access</p>
                        <h2 id="loginHeading">Welcome back</h2>
                        <p>Sign in to continue to Squad Internal.</p>
                    </header>

                    @if (ViewBag.Error != null)
                    {
                        <div class="alert-box show error" role="alert">@ViewBag.Error</div>
                    }

                    @if (ViewBag.Success != null)
                    {
                        <div class="alert-box show success" role="status">@ViewBag.Success</div>
                    }

                    <form asp-action="Login" asp-controller="Account" method="post" id="loginForm" novalidate>
                        @Html.AntiForgeryToken()

                        <div class="auth-field">
                            <label class="auth-label" for="emailInput">Work email</label>
                            <input type="email"
                                   name="Email"
                                   id="emailInput"
                                   class="auth-input"
                                   placeholder="you@company.com"
                                   value="@ViewBag.Email"
                                   autocomplete="username"
                                   required />
                            <span class="invalid-feedback" id="emailError">Please enter a valid email address.</span>
                        </div>

                        <div class="auth-field">
                            <label class="auth-label" for="passwordInput">Password</label>
                            <div class="auth-input-wrap">
                            <input type="password"
                                   name="Password"
                                   id="passwordInput"
                                   class="auth-input auth-password-input"
                                   placeholder="Enter your password"
                                   autocomplete="current-password"
                                   required />
                            <button type="button" class="auth-password-toggle" id="toggleBtn" aria-label="Toggle password visibility">
                                <i class="bi bi-eye" id="eyeIcon"></i>
                            </button>
                            </div>
                            <span class="invalid-feedback" id="passwordError">Password must be at least 6 characters.</span>
                        </div>

                        <div class="auth-options">
                            <a class="auth-forgot" asp-action="ForgotPassword">Forgot password?</a>
                        </div>

                        <button type="submit" class="auth-submit">Sign in <i class="bi bi-arrow-right" aria-hidden="true"></i></button>
                    </form>
                    <p class="auth-footer">© @DateTime.Now.Year Squad Logic</p>
                </div>
            </section>
        </main>
    </div>

    <script>
            (function() {
                const form = document.getElementById('loginForm');
                const emailInput = document.getElementById('emailInput');
                const passwordInput = document.getElementById('passwordInput');
                const emailError = document.getElementById('emailError');
                const passwordError = document.getElementById('passwordError');
                const alertBoxes = document.querySelectorAll('.alert-box');

                const toggleBtn = document.getElementById('toggleBtn');
                const eyeIcon = document.getElementById('eyeIcon');

                if (toggleBtn) {
                    toggleBtn.addEventListener('click', function(e) {
                        e.preventDefault();
                        if (passwordInput.type === 'password') {
                            passwordInput.type = 'text';
                            eyeIcon.classList.remove('bi-eye');
                            eyeIcon.classList.add('bi-eye-slash');
                        } else {
                            passwordInput.type = 'password';
                            eyeIcon.classList.remove('bi-eye-slash');
                            eyeIcon.classList.add('bi-eye');
                        }
                    });
                }

                function setValid(input, errorEl) {
                    input.classList.remove('is-invalid');
                    errorEl.classList.remove('show');
                }

                function setInvalid(input, errorEl) {
                    input.classList.add('is-invalid');
                    errorEl.classList.add('show');
                }

                function validateEmail() {
                    const val = emailInput.value.trim();
                    const emailPattern = /^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/;
                    if (val === '' || !emailPattern.test(val)) {
                        setInvalid(emailInput, emailError);
                        return false;
                    } else {
                        setValid(emailInput, emailError);
                        return true;
                    }
                }

                function validatePassword() {
                    const val = passwordInput.value.trim();
                    if (val.length < 6) {
                        setInvalid(passwordInput, passwordError);
                        return false;
                    } else {
                        setValid(passwordInput, passwordError);
                        return true;
                    }
                }

                if (emailInput) {
                    emailInput.addEventListener('input', function() {
                        validateEmail();
                        alertBoxes.forEach(box => box.classList.remove('show'));
                    });
                    emailInput.addEventListener('blur', validateEmail);
                }

                if (passwordInput) {
                    passwordInput.addEventListener('input', function() {
                        validatePassword();
                        alertBoxes.forEach(box => box.classList.remove('show'));
                    });
                    passwordInput.addEventListener('blur', validatePassword);
                }

                if (form) {
                    form.addEventListener('submit', function(e) {
                        const isEmailValid = validateEmail();
                        const isPasswordValid = validatePassword();

                        if (!isEmailValid || !isPasswordValid) {
                            e.preventDefault();
                            if (!isEmailValid) emailInput.focus();
                            else if (!isPasswordValid) passwordInput.focus();
                        }
                    });
                }

                

            })();
    </script>

</body>
</html>