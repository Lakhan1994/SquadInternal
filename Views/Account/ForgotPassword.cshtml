@{
    ViewData["Title"] = "Forgot Password";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>@ViewData["Title"] · Squad Logic</title>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">

    <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@@14..32,400;14..32,500;14..32,600;14..32,700;14..32,800&display=swap"
          rel="stylesheet">

    <style>

            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }

            body {
                background: #eef1f7;
                font-family: 'Inter', 'Segoe UI', sans-serif;
                min-height: 100vh;
                display: flex;
                align-items: center;
                justify-content: center;
                padding: 1.5rem;
            }

            /* =========================================================
                       MAIN WRAPPER
                       ========================================================= */

            .login-wrapper {
                width: 100%;
                max-width: 1200px;
            }

            /* =========================================================
                       MAIN CONTAINER
                       ========================================================= */

            .login-container {
                display: flex;
                border-radius: 28px;
                overflow: hidden;
                background: #ffffff;
                box-shadow: 0 30px 60px rgba(0, 0, 0, 0.10);
                min-height: 650px;
            }

            /* =========================================================
                       LEFT PANEL
                       ========================================================= */

            .left-panel {
                width: 60%;
                background: linear-gradient( 135deg, #f8f9ff 0%, #eef1f7 100% );
                padding: 50px 40px 40px;
                display: flex;
                flex-direction: column;
                align-items: center;
                justify-content: center;
                text-align: center;
                position: relative;
            }

            /* =========================================================
                       LOGO
                       ========================================================= */

            .logo-container {
                margin-bottom: 20px;
            }

            .logo-text {
                font-weight: 800;
                font-size: 36px;
                letter-spacing: 3px;
                color: #1a1e2b;
                text-transform: uppercase;
                background: linear-gradient( 135deg, #4a58c9, #6f7cff );
                -webkit-background-clip: text;
                -webkit-text-fill-color: transparent;
                background-clip: text;
            }

            .logo-tagline {
                font-weight: 600;
                font-size: 14px;
                letter-spacing: 6px;
                color: #6b7280;
                text-transform: uppercase;
                margin-top: 2px;
            }

                .logo-tagline span {
                    color: #6f7cff;
                }

            /* =========================================================
                       LEFT CONTENT
                       ========================================================= */

            .left-panel h2 {
                font-weight: 700;
                font-size: 28px;
                letter-spacing: -0.3px;
                color: #1a1e2b;
                margin-bottom: 4px;
            }

            .left-panel .subhead {
                color: #6b7280;
                font-size: 15px;
                font-weight: 400;
                margin-bottom: 20px;
            }

            /* =========================================================
                       ILLUSTRATION
                       ========================================================= */

            .illustration {
                width: 360px;
                max-width: 70%;
                height: auto;
                margin-top: 10px;
                filter: drop-shadow( 0 12px 18px rgba(0, 0, 0, 0.06) );
                display: block;
            }

            /* =========================================================
                       WATERMARK
                       ========================================================= */

            .watermark {
                position: absolute;
                bottom: 28px;
                left: 50%;
                transform: translateX(-50%);
                width: 60%;
                height: 90px;
                background: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 200 40"><text x="0" y="28" font-family="Inter, sans-serif" font-weight="800" font-size="22" fill="%23d0d5e0" opacity="0.2">SQUAD LOGIC</text></svg>') no-repeat center;
                background-size: contain;
                pointer-events: none;
            }

            /* =========================================================
                       RIGHT PANEL
                       ========================================================= */

            .right-panel {
                width: 40%;
                background: linear-gradient( 145deg, #6f7cff, #4a58c9 );
                display: flex;
                justify-content: center;
                align-items: center;
                padding: 2rem 1.5rem;
                position: relative;
                overflow: hidden;
            }

                .right-panel::before {
                    content: '';
                    position: absolute;
                    top: -50%;
                    right: -50%;
                    width: 200%;
                    height: 200%;
                    background: radial-gradient( circle at 70% 30%, rgba(255,255,255,0.05) 0%, transparent 70% );
                    pointer-events: none;
                }

                .right-panel::after {
                    content: 'SL';
                    position: absolute;
                    bottom: 20px;
                    right: 20px;
                    font-size: 80px;
                    font-weight: 800;
                    color: rgba(255,255,255,0.04);
                    letter-spacing: -5px;
                    pointer-events: none;
                }

            /* =========================================================
                       FORGOT PASSWORD CARD
                       ========================================================= */

            .login-card {
                background: #ffffff;
                padding: 2.2rem 2rem 2rem;
                border-radius: 20px;
                width: 100%;
                max-width: 380px;
                box-shadow: 0 20px 40px rgba(0, 0, 0, 0.25);
                transform: translateX(-20px);
                position: relative;
                z-index: 1;
            }

                .login-card h5 {
                    font-weight: 700;
                    font-size: 20px;
                    color: #111827;
                    margin-bottom: 4px;
                    text-align: center;
                }

            .secure-text {
                color: #6b7280;
                font-size: 13px;
                text-align: center;
                margin-bottom: 24px;
                line-height: 1.5;
            }

            /* =========================================================
                       FORM
                       ========================================================= */

            .form-group {
                margin-bottom: 1.1rem;
                position: relative;
            }

            .form-label {
                display: block;
                color: #374151;
                font-size: 13px;
                font-weight: 600;
                margin-bottom: 7px;
            }

            .custom-input {
                width: 100%;
                padding: 12px 16px;
                border-radius: 12px;
                border: 1px solid #e5e7eb;
                font-size: 14px;
                font-weight: 500;
                background: #f9fafb;
                transition: 0.2s ease;
                outline: none;
                color: #111827;
            }

                .custom-input:focus {
                    border-color: #6f7cff;
                    background: #ffffff;
                    box-shadow: 0 0 0 4px rgba(108, 122, 224, 0.15);
                }

                .custom-input.is-invalid {
                    border-color: #e53e3e;
                    background: #fff5f5;
                }

            /* =========================================================
                       BUTTON
                       ========================================================= */

            .btn-login {
                background: linear-gradient( 135deg, #6f7cff, #4a58c9 );
                color: white;
                border: none;
                border-radius: 12px;
                padding: 13px;
                font-weight: 600;
                font-size: 15px;
                width: 100%;
                transition: 0.2s;
                box-shadow: 0 8px 18px rgba(90, 103, 216, 0.25);
                cursor: pointer;
            }

                .btn-login:hover {
                    transform: translateY(-2px);
                    box-shadow: 0 12px 24px rgba(90, 103, 216, 0.35);
                }

                .btn-login:disabled {
                    opacity: 0.65;
                    cursor: not-allowed;
                    transform: none;
                }

            /* =========================================================
                       BACK TO LOGIN
                       ========================================================= */

            .back-login {
                text-align: center;
                margin-top: 20px;
            }

                .back-login a {
                    color: #6f7cff;
                    text-decoration: none;
                    font-size: 13px;
                    font-weight: 600;
                }

                    .back-login a:hover {
                        color: #4a58c9;
                        text-decoration: underline;
                    }

            /* =========================================================
                       OTP
                       ========================================================= */

            .otp-input {
                letter-spacing: 6px;
                text-align: center;
                font-size: 18px;
                font-weight: 700;
            }

            /* =========================================================
                       PASSWORD MESSAGE
                       ========================================================= */

            #passwordMessage {
                display: block;
                font-size: 12px;
                margin-top: 6px;
            }

            /* =========================================================
                       RESPONSIVE
                       ========================================================= */

            @@media (max-width: 820px) {

                .login-container {
                    flex-direction: column;
                    border-radius: 24px;
                    min-height: auto;
                }

                .left-panel,
                .right-panel {
                    width: 100%;
                }

                .left-panel {
                    padding: 30px 20px 30px;
                }

                .watermark {
                    display: none;
                }

                .illustration {
                    max-width: 55%;
                    margin: 10px auto 0;
                }

                .right-panel {
                    padding: 2rem 1.5rem;
                }

                    .right-panel::after {
                        display: none;
                    }

                .login-card {
                    transform: translateX(0);
                    max-width: 100%;
                    padding: 1.8rem 1.5rem;
                }

                .left-panel h2 {
                    font-size: 26px;
                }

                .logo-text {
                    font-size: 28px;
                }
            }

            @@media (max-width: 480px) {

                body {
                    padding: 10px;
                }

                .login-card {
                    padding: 1.5rem 1rem;
                }

                .left-panel h2 {
                    font-size: 22px;
                }

                .illustration {
                    max-width: 70%;
                }

                .logo-text {
                    font-size: 24px;
                }

                .logo-tagline {
                    font-size: 11px;
                    letter-spacing: 4px;
                }
            }

    </style>
</head>

<body>

    <div class="login-wrapper">

        <div class="login-container">

            <!-- =====================================================
             LEFT PANEL
             ===================================================== -->

            <div class="left-panel">

                <div class="logo-container">

                    <div class="logo-text">
                        SQUAD LOGIC
                    </div>

                    <div class="logo-tagline">
                        TREAT WITH <span>TECHNOLOGY</span>
                    </div>

                </div>

                <h2>
                    Account Recovery
                </h2>

                <p class="subhead">
                    Securely recover your Squad Logic account
                </p>

                <!-- Same style of illustration as Login page -->
                <svg class="illustration"
                     viewBox="0 0 300 140"
                     fill="none"
                     xmlns="http://www.w3.org/2000/svg">

                    <rect x="20"
                          y="15"
                          width="260"
                          height="110"
                          rx="16"
                          fill="#E8ECF4" />

                    <!-- Lock -->
                    <rect x="105"
                          y="58"
                          width="70"
                          height="50"
                          rx="10"
                          fill="#6F7CFF"
                          opacity="0.25" />

                    <path d="M120 58V48C120 34 130 25 140 25C150 25 160 34 160 48V58"
                          stroke="#6F7CFF"
                          stroke-width="8"
                          stroke-linecap="round"
                          opacity="0.65" />

                    <circle cx="140"
                            cy="80"
                            r="7"
                            fill="#6F7CFF" />

                    <rect x="137"
                          y="80"
                          width="6"
                          height="14"
                          rx="3"
                          fill="#6F7CFF" />

                    <circle cx="65"
                            cy="55"
                            r="16"
                            fill="#6F7CFF"
                            opacity="0.15" />

                    <circle cx="235"
                            cy="90"
                            r="20"
                            fill="#D9E0F5" />

                    <circle cx="245"
                            cy="60"
                            r="7"
                            fill="#6F7CFF"
                            opacity="0.25" />

                </svg>

                <div class="watermark"></div>

            </div>


            <!-- =====================================================
             RIGHT PANEL
             ===================================================== -->

            <div class="right-panel">

                <div class="login-card">

                    <h5>
                        Forgot Password
                    </h5>

                    <p class="secure-text">
                        Securely reset your Squad Logic account password
                    </p>


                    <!-- =================================================
                     STEP 1 - EMAIL
                     ================================================= -->

                    <div id="stepEmail">

                        <div class="form-group">

                            <label class="form-label">
                                Email Address
                            </label>

                            <input type="email"
                                   id="email"
                                   class="custom-input"
                                   placeholder="name@company.net" />

                        </div>

                        <button type="button"
                                id="btnSendOtp"
                                class="btn-login"
                                onclick="sendOtp()">

                            <i class="bi bi-send me-1"></i>
                            Send OTP

                        </button>

                    </div>


                    <!-- =================================================
                     STEP 2 - OTP
                     ================================================= -->

                    <div id="stepOtp" style="display:none;">

                        <div class="form-group">

                            <label class="form-label">
                                Enter OTP
                            </label>

                            <input type="text"
                                   id="otp"
                                   class="custom-input otp-input"
                                   placeholder="6-digit OTP"
                                   maxlength="6" />

                        </div>


                        <div class="form-check mb-3">

                            <input type="checkbox"
                                   id="confirmCheck"
                                   class="form-check-input"
                                   onchange="toggleVerifyButton()" />

                            <label class="form-check-label"
                                   for="confirmCheck">

                                I confirm this is my account

                            </label>

                        </div>


                        <button type="button"
                                id="btnVerifyOtp"
                                class="btn-login"
                                onclick="verifyOtp()"
                                disabled>

                            <i class="bi bi-shield-check me-1"></i>
                            Verify OTP

                        </button>

                    </div>


                    <!-- =================================================
                     RESEND OTP
                     ================================================= -->

                    <div class="text-center mt-3" id="resendContainer" style="display:none;">

                        <small id="resendText" class="text-muted">
                            Resend OTP in <span id="countdown">60</span>s
                        </small>

                        <button type="button"
                                id="btnResend"
                                class="btn btn-link p-0 ms-2"
                                style="display:none;"
                                onclick="resendOtp()">
                            Resend OTP
                        </button>

                    </div>


                    <!-- =================================================
                     STEP 3 - RESET PASSWORD
                     ================================================= -->

                    <div id="stepReset"
                         style="display:none;">

                        <div class="form-group">

                            <label class="form-label">
                                New Password
                            </label>

                            <input type="password"
                                   id="newPassword"
                                   class="custom-input"
                                   placeholder="Enter new password"
                                   onkeyup="checkPasswords()" />

                        </div>


                        <div class="form-group">

                            <label class="form-label">
                                Confirm Password
                            </label>

                            <input type="password"
                                   id="confirmPassword"
                                   class="custom-input"
                                   placeholder="Confirm password"
                                   onkeyup="checkPasswords()" />

                            <small id="passwordMessage"></small>

                        </div>


                        <button type="button"
                                id="btnReset"
                                class="btn-login"
                                onclick="resetPassword()"
                                disabled>

                            <i class="bi bi-key me-1"></i>
                            Update Password

                        </button>

                    </div>


                    <!-- =================================================
                     BACK TO LOGIN
                     ================================================= -->

                    <div class="back-login">

                        <a asp-controller="Account"
                           asp-action="Login">

                            <i class="bi bi-arrow-left me-1"></i>
                            Back to Login

                        </a>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- =============================================================
     JAVASCRIPT
     ============================================================= -->

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <script>

            function sendOtp() {

                var email = $("#email").val().trim();

                if (!email) {

                    $("#email")
                        .addClass("is-invalid")
                        .focus();

                    return;
                }

                $("#email").removeClass("is-invalid");

                $("#btnSendOtp")
                    .prop("disabled", true)
                    .html(
                        '<span class="spinner-border spinner-border-sm me-1"></span> Sending...'
                    );

                $.post(
                    "@Url.Action("SendOtp", "Account")",
                    {
                        email: email
                    },
                    function (res) {

                        if (!res.success) {

                            alert(res.message);

                            $("#btnSendOtp")
                                .prop("disabled", false)
                                .html(
                                    '<i class="bi bi-send me-1"></i> Send OTP'
                                );

                            return;
                        }

                        $("#stepEmail").hide();

                        $("#stepOtp").show();

                        startTimer();

                        $("#btnSendOtp")
                            .prop("disabled", false)
                            .html(
                                '<i class="bi bi-send me-1"></i> Send OTP'
                            );

                    }
                );
            }


            function verifyOtp() {

                var email = $("#email").val();

                var otp = $("#otp").val();

                $.post(
                    "/Account/VerifyOtp",
                    {
                        email: email,
                        otp: otp
                    },
                    function (res) {

                        if (res.success) {

                            $("#stepOtp").hide();

                            $("#stepReset").show();

                        }
                        else {

                            alert(res.message);

                        }

                    }
                );
            }


            function resetPassword() {

                var email = $("#email").val();

                var newPassword =
                    $("#newPassword").val();

                var confirmPassword =
                    $("#confirmPassword").val();


                $.post(
                    "/Account/ResetPassword",
                    {
                        email: email,
                        newPassword: newPassword,
                        confirmPassword: confirmPassword
                    },
                    function (res) {

                        if (res.success) {

                            $("#stepReset").html(`
                                    <div class="text-center">

                                        <div style="
                                            width:60px;
                                            height:60px;
                                            border-radius:50%;
                                            background:#d1fae5;
                                            display:flex;
                                            align-items:center;
                                            justify-content:center;
                                            margin:0 auto 15px;
                                            color:#059669;
                                            font-size:28px;
                                        ">
                                            <i class="bi bi-check-lg"></i>
                                        </div>

                                        <h6 class="fw-bold">
                                            Password Updated
                                        </h6>

                                        <p class="text-muted small mb-0">
                                            Your password has been updated successfully.
                                        </p>

                                    </div>
                                `);

                            setTimeout(function () {

                                window.location.href =
                                    "/Account/Login";

                            }, 1500);

                        }

                    }
                );
            }


            function checkPasswords() {

                var newPassword =
                    $("#newPassword").val();

                var confirmPassword =
                    $("#confirmPassword").val();

                var message =
                    $("#passwordMessage");


                if (newPassword.length === 0 &&
                    confirmPassword.length === 0) {

                    message
                        .text("");

                    $("#btnReset")
                        .prop("disabled", true);

                    return;
                }


                if (newPassword === confirmPassword &&
                    newPassword.length >= 6) {

                    message
                        .removeClass("text-danger")
                        .addClass("text-success")
                        .text("✓ Passwords match");

                    $("#btnReset")
                        .prop("disabled", false);

                }
                else {

                    message
                        .removeClass("text-success")
                        .addClass("text-danger")
                        .text("✗ Passwords must match and contain at least 6 characters");

                    $("#btnReset")
                        .prop("disabled", true);

                }

            }


            var timerInterval;

            var countdownTime = 60;


            function startTimer() {

                clearInterval(timerInterval);

                countdownTime = 60;

                $("#countdown")
                    .text(countdownTime);

                $("#resendText")
                    .show();

                $("#btnResend")
                    .hide();


                timerInterval =
                    setInterval(function () {

                        countdownTime--;

                        $("#countdown")
                            .text(countdownTime);


                        if (countdownTime <= 0) {

                            clearInterval(timerInterval);

                            $("#resendText")
                                .hide();

                            $("#btnResend")
                                .show();

                        }

                    }, 1000);

            }


            function sendOtp() {

                var email = $("#email").val().trim();

                if (!email) {
                    $("#email")
                        .addClass("is-invalid")
                        .focus();

                    return;
                }

                $("#email").removeClass("is-invalid");

                $("#btnSendOtp")
                    .prop("disabled", true)
                    .html(
                        '<span class="spinner-border spinner-border-sm me-1"></span> Sending...'
                    );

                $.post(
                    "@Url.Action("SendOtp", "Account")",
                    {
                        email: email
                    },
                    function (res) {

                        if (!res.success) {

                            alert(res.message);

                            $("#btnSendOtp")
                                .prop("disabled", false)
                                .html(
                                    '<i class="bi bi-send me-1"></i> Send OTP'
                                );

                            return;
                        }

                        // Hide email step
                        $("#stepEmail").hide();

                        // Show OTP step
                        $("#stepOtp").show();

                        // Show resend section
                        $("#resendContainer").show();

                        // Start 60 second countdown
                        startTimer();

                        $("#btnSendOtp")
                            .prop("disabled", false)
                            .html(
                                '<i class="bi bi-send me-1"></i> Send OTP'
                            );

                    }
                );
            }


            function toggleVerifyButton() {

                $("#btnVerifyOtp")
                    .prop(
                        "disabled",
                        !$("#confirmCheck").is(":checked")
                    );

            }

    </script>

</body>
</html>